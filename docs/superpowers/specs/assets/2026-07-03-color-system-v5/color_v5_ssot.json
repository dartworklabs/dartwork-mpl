 "colormaps": {
  "access": "dm.cmap(\"<name>\") — 평면 네임스페이스. mpl 레지스트리 등록명은 \"dc.<name>\" (내장 pink·gray 충돌 차단, cmo./cmr./cmc. 관행)",
  "grammar": {
   "rule": "이름은 색 정체성, 접미사는 변형 (_r 역방향 · _deep/_soft diverging 강도)",
   "single_hue": "family명 그대로 (blue, red, …, gray) — 팔레트 family 레시피의 연속 렌더링(A8 광역 L*)",
   "multi_hue": "자연광 장면 고유명 (aurora=기본, afterglow, blaze, lava, lagoon, glacier, canopy, haze, iris) — hue knot은 family 앵커 h0에서만, knot 사이는 단조 3차(pchip)로 통과",
   "diverging": "저값_고값 pair명 (blue_red 등 13) — 양극 = dc.{a}6/dc.{b}6에서 유도",
   "topo": "기준면 2단 multi-sequential (coast) — 반부별 독립 L* 단조 ramp, 중앙(해안선) L* 불연속은 설계 (기준면 0이 시각적으로 튀도록)",
   "cyclic": "원형 빛 현상 (halo, corona) + 구조명 hue — 팔은 family hue 앵커",
   "qualitative": "팔레트 cycle을 ListedColormap으로 등록 (dc.cycle, dc.cycle_print) — 신규 디자인 없음, 범주형 c= 인자 호환용",
   "direction": "잉크 계열(단일색·diverging): 고값=진함 / 빛 계열(멀티휴·cyclic): 고값=밝음 / topo: 기준면에서 멀수록 어두움(심해)·밝음(고봉). 반전은 _r"
  },
