 "colormaps": {
  "access": "matplotlib 레지스트리 네이티브 — cmap=\"dc.<name>\" / plt.colormaps[\"dc.<name>\"] / dm.list_colormaps(). 별도 파이썬 접근자 없음(기존 관용·기술부채 0). 등록명 접두사 dc.는 mpl 내장 pink·gray 및 dartwork_mpl.cmap 모듈 충돌 회피 (cmo./cmr./cmc. 관행).",
  "grammar": {
   "rule": "이름은 색 정체성, 접미사는 변형 (_r 역방향)",
   "single_hue": "family명 그대로 (blue, red, …, gray) — 팔레트 family 레시피의 연속 렌더링(A8 광역 L*)",
   "multi_hue": "자연광 장면 고유명 (aurora=기본, afterglow, blaze, lava, lagoon, glacier, canopy, haze, iris) — hue knot은 family 앵커 h0에서만, knot 사이는 단조 3차(pchip)로 통과",
   "diverging": "저값_고값 pair명 (blue_red 등 11) — 양극 = dc.{a}6/dc.{b}6에서 유도",
   "cyclic": "원형 빛 현상 (halo, corona) + 구조명 hue — 팔은 family hue 앵커",
   "qualitative": "팔레트 cycle을 ListedColormap으로 등록 (dc.cycle, dc.cycle_print) — 신규 디자인 없음, 범주형 c= 인자 호환용",
   "direction": "잉크 계열(단일색·diverging): 고값=진함 / 빛 계열(멀티휴·cyclic): 고값=밝음. 반전은 _r"
