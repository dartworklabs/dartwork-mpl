digraph dartwork_mpl {
  rankdir="LR";
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#cdced6", fontsize=11, margin="0.18,0.10",
        fontname="Inter, system-ui, sans-serif"];
  edge [color="#9498a3", arrowsize=0.6, penwidth=0.9];
  subgraph cluster_api {
    label="Plotting API (the part you import)";
    style="rounded,filled";
    fillcolor="#fafafb";
    color="#dfe0e6";
    fontsize=10;
    fontcolor="#60646c";
    node [color="#0d8ee8", penwidth=1.2];
    "style";
    "layout";
    "io";
    "annotation";
    "scale";
    "units";
    "icon";
  }
  subgraph cluster_data {
    label="Design tokens & assets";
    style="rounded,filled";
    fillcolor="#fafafb";
    color="#dfe0e6";
    fontsize=10;
    fontcolor="#60646c";
    node [color="#0090a8", penwidth=1.2];
    "colors";
    "cmap";
    "font";
    "asset_viz";
  }
  subgraph cluster_support {
    label="Tooling, agent, validation";
    style="rounded,filled";
    fillcolor="#fafafb";
    color="#dfe0e6";
    fontsize=10;
    fontcolor="#60646c";
    node [color="#9750c1", penwidth=1.2];
    "mcp";
    "ui";
    "validate";
    "validate_fixes";
    "lint";
    "diagnostics";
    "explore";
    "helpers";
    "_helpers";
    "templates";
    "prompt";
    "util";
    "cli";
    "config";
  }
  "_checks";
  "_color";
  "_colormaps";
  "_colors";
  "_config";
  "_conversion";
  "_fonts";
  "_loader";
  "_orchestrator";
  "_param";
  "_scaffold";
  "_scripts";
  "_styles";
  "_template";
  "_types";
  "_typing";
  "_views";
  "_widget";
  "clipped_text";
  "cross_axes";
  "data";
  "diverging_bar";
  "empty_axes";
  "labels";
  "legend";
  "margin";
  "overflow";
  "overlap";
  "pie_label";
  "prompts";
  "quality";
  "resources";
  "server";
  "tick_crowd";
  "tools";
  "annotation" -> "_helpers" [penwidth=0.75];
  "annotation" -> "scale" [penwidth=0.75];
  "asset_viz" -> "diagnostics" [penwidth=0.75];
  "cli" -> "mcp" [penwidth=0.75];
