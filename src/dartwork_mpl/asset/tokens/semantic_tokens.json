{
  "version": "3",
  "type_scale": {
    "annotation": {
      "rcparam": "font.size",
      "offset": -2.0,
      "multiplier": 1.0
    },
    "tick": {
      "rcparam": "font.size",
      "offset": -1.0,
      "multiplier": 1.0
    },
    "body": {
      "rcparam": "font.size",
      "offset": 0.0,
      "multiplier": 1.0
    },
    "label": {
      "rcparam": "font.size",
      "offset": 0.0,
      "multiplier": 1.0
    },
    "emphasis": {
      "rcparam": "font.size",
      "offset": 1.0,
      "multiplier": 1.0
    },
    "title": {
      "rcparam": "font.size",
      "offset": 2.0,
      "multiplier": 1.0
    }
  },
  "lw_ladder": {
    "hairline": {
      "rcparam": "lines.linewidth",
      "offset": 0.0,
      "multiplier": 0.3
    },
    "reference": {
      "rcparam": "lines.linewidth",
      "offset": 0.0,
      "multiplier": 0.5
    },
    "trend": {
      "rcparam": "lines.linewidth",
      "offset": 0.0,
      "multiplier": 1.0
    },
    "emphasis": {
      "rcparam": "lines.linewidth",
      "offset": 0.0,
      "multiplier": 1.6
    }
  },
  "scatter_size": {
    "small": 16.0,
    "default": 30.0,
    "emphasis": 45.0
  },
  "spacing": {
    "xs": 2.0,
    "sm": 4.0,
    "md": 8.0,
    "lg": 12.0,
    "xl": 16.0
  }
