# Dark mode color scheme
figure.facecolor:   "#1e1e1e"
figure.edgecolor:   "#1e1e1e"

axes.facecolor:     "#1e1e1e"
axes.edgecolor:     "#555555"
axes.labelcolor:    "#cccccc"

text.color:         "#e0e0e0"

xtick.color:        "#aaaaaa"
xtick.labelcolor:   "#cccccc"
ytick.color:        "#aaaaaa"
ytick.labelcolor:   "#cccccc"

grid.color:         "#333333"

legend.edgecolor:   "#555555"
legend.facecolor:   "#1e1e1e"
legend.labelcolor:  "#cccccc"

savefig.facecolor:  "#1e1e1e"

# categorical cycle — separately gated for the #1e1e1e background. Each of
# these seven family steps has WCAG contrast >= 3.8; WCAG contrast luminance is
# distinct from modeled relative CIE Y (`relative_y`) calculated from nominal
# D65 sRGB. Neither modeled quantity measures a display or print process. Pair
# separation is validation-only ΔE00 under normal vision, Machado (2009)
# protan/deutan, and BVM (1997) tritan simulation (worst-case minimum 11.0).
# The hue order matches the light cycle; see tests/test_theme_dark_cycle.py.
axes.prop_cycle: cycler('color', ['dc.blue3', 'dc.orange3', 'dc.green9', 'dc.pink6', 'dc.amber6', 'dc.violet5', 'dc.cyan6'])
