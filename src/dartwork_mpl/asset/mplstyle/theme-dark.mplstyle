# Dark mode color scheme
figure.facecolor:   "#1e1e1e"
figure.edgecolor:   "#1e1e1e"

axes.facecolor:     "#1e1e1e"
axes.edgecolor:     "#555555"
axes.labelcolor:    "#cccccc"

text.color:         "#e0e0e0"

xtick.color:        "#aaaaaa"
xtick.labelcolor:   "#cccccc"
ytick.color:        "#aaaaaa"
ytick.labelcolor:   "#cccccc"

grid.color:         "#333333"

legend.edgecolor:   "#555555"
legend.facecolor:   "#1e1e1e"
legend.labelcolor:  "#cccccc"

savefig.facecolor:  "#1e1e1e"

# categorical cycle — dark-background-gated generated families. The white
# v5 cycle is contrast-gated against white, so it is void on this dark
# facecolor; these seven steps are the bg_L-aware version — each legible on
# #1e1e1e (WCAG contrast >= 3.8) and mutually distinct under normal + deutan +
# protan + tritan simulation (worst-case min CIEDE2000 11.0, above the 10 gate
# and on par with Okabe-Ito 11.1). Same hue order as the light cycle; see
# tests/test_theme_dark_cycle.py for the live gate.
axes.prop_cycle: cycler('color', ['dc.blue3', 'dc.orange3', 'dc.green9', 'dc.pink6', 'dc.amber6', 'dc.violet5', 'dc.cyan6'])
