font.weight:  300
font.size:    12.0

axes.titlesize:     14.0
axes.titleweight:   500
axes.labelsize:     12.0
axes.labelweight:   400

xtick.labelsize:     11.0
ytick.labelsize:     11.0

xtick.major.size:    4
xtick.major.width:   0.5
ytick.major.size:    4
ytick.major.width:   0.5

lines.linewidth:     1.5

legend.fontsize:      9.0

figure.titlesize:   14.0
figure.titleweight: 500
figure.labelsize:   12.0
figure.labelweight: 400

axes.linewidth:     0.5
axes.spines.top:    False
axes.spines.right:  False

# categorical cycle — Bold (curated high-contrast punch for large-format)
axes.prop_cycle: cycler('color', ['dc.bold0', 'dc.bold1', 'dc.bold2', 'dc.bold3', 'dc.bold4', 'dc.bold5'])
