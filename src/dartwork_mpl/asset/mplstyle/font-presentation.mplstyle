# Slides: the scientific preset with every point size multiplied by 2.6.
#
# 2.6 is the slide body under a title (23.4 cm) over a journal column (9 cm),
# so a chart drawn here looks like a column figure enlarged as a vector to
# the slide: text, lines, markers, tick lengths and pads all grow together.
# Every slide chart uses the same factor, whatever its width.
# style/tests/test_presentation_scale.py checks each value below against
# scientific x 2.6, so change the scientific values and these together.
# dm.fs / dm.lw take 2.6 pt steps under this preset
# (dartwork_mpl.style.step_pt).

font.weight:  light
font.size:    19.5

axes.titlesize:     22.1  # font size of the axes title
axes.titleweight:   normal # font weight of title
axes.titlepad:      15.6
axes.labelsize:     19.5  # font size of the x and y labels
axes.labelweight:   400  # weight of the x and y labels
axes.labelpad:      10.4
axes.linewidth:     0.78

xtick.labelsize:     18.2  # font size of the tick labels
ytick.labelsize:     18.2  # font size of the tick labels
xtick.major.size:    5.2
xtick.minor.size:    2.6
xtick.major.width:   0.78
xtick.minor.width:   0.52
xtick.major.pad:     5.2
xtick.minor.pad:     5.2
ytick.major.size:    5.2
ytick.minor.size:    2.6
ytick.major.width:   0.78
ytick.minor.width:   0.52
ytick.major.pad:     2.6
ytick.minor.pad:     2.6

legend.fontsize:      15.6

figure.titlesize:   22.1   # size of the figure title
figure.titleweight: normal # weight of the figure title
figure.labelsize:   19.5     # size of the figure label
figure.labelweight: 300    # weight of the figure label

lines.linewidth:        2.6
lines.markersize:       7.8
lines.markeredgewidth:  2.6
patch.linewidth:        1.3
hatch.linewidth:        2.6
grid.linewidth:         0.78

boxplot.boxprops.linewidth:          2.6
boxplot.capprops.linewidth:          2.6
boxplot.whiskerprops.linewidth:      2.6
boxplot.medianprops.linewidth:       2.6
boxplot.meanprops.linewidth:         2.6
boxplot.meanprops.markersize:        15.6
boxplot.flierprops.linewidth:        2.6
boxplot.flierprops.markeredgewidth:  2.6
boxplot.flierprops.markersize:       15.6
