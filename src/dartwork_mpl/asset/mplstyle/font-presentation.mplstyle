font.weight:  300
font.size:    10.5

axes.titlesize:     11.5  # font size of the axes title
axes.titleweight:   400  # font weight of title
axes.labelsize:     10.5  # font size of the x and y labels
axes.labelweight:   400  # weight of the x and y labels

xtick.labelsize:     10  # font size of the tick labels
ytick.labelsize:     10  # font size of the tick labels

legend.fontsize:      8.5

figure.titlesize:   11.5   # size of the figure title
figure.titleweight: 400    # weight of the figure title
figure.labelsize:   10.5     # size of the figure label
figure.labelweight: 300    # weight of the figure label

# categorical cycle — Bold (curated high-contrast punch for slides)
axes.prop_cycle: cycler('color', ['dc.bold0', 'dc.bold1', 'dc.bold2', 'dc.bold3', 'dc.bold4', 'dc.bold5'])
