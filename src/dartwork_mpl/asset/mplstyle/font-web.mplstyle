font.weight:  300
font.size:    11.0

axes.titlesize:     13.0
axes.titleweight:   500
axes.labelsize:     11.0
axes.labelweight:   400

xtick.labelsize:     10
ytick.labelsize:     10

legend.fontsize:      8.5

figure.titlesize:   13.0
figure.titleweight: 500
figure.labelsize:   11.0
figure.labelweight: 400

axes.linewidth:     0.4
axes.spines.top:    False
axes.spines.right:  False

# categorical cycle — Spectrum (vivid full-wheel for screen)
axes.prop_cycle: cycler('color', ['dc.spectrum0', 'dc.spectrum1', 'dc.spectrum2', 'dc.spectrum3', 'dc.spectrum4', 'dc.spectrum5'])
