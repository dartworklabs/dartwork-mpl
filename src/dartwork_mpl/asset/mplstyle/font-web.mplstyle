font.family: sans-serif
font.sans-serif: Roboto, Lato, Inter, Open Sans, Arial, Helvetica, sans-serif

mathtext.fontset: custom

mathtext.bf:  Noto Sans Math:bold
mathtext.cal: Noto Sans Math
mathtext.it:  Noto Sans Math:italic
mathtext.rm:  Noto Sans Math
mathtext.sf:  Noto Sans Math
mathtext.tt:  Noto Sans Math
mathtext.fallback: None
mathtext.default: it

font.weight:  300
font.size:    11.0

axes.titlesize:     13.0
axes.titleweight:   500
axes.labelsize:     11.0
axes.labelweight:   400

xtick.labelsize:     10
ytick.labelsize:     10

legend.fontsize:      8.5

figure.titlesize:   13.0
figure.titleweight: 500
figure.labelsize:   11.0
figure.labelweight: 400
figure.figsize:     6.0, 4.5
figure.dpi:         150

axes.linewidth:     0.4
axes.spines.top:    False
axes.spines.right:  False

savefig.dpi:        150
